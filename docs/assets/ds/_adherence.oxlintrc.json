{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/core/**",
              "components/media/**",
              "components/surfaces/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:MTCustomIcons|Big Shoulders|Outfit|Geist Mono|Andika|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: MTCustomIcons, Big Shoulders, Outfit, Geist Mono, Andika, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|full|icon|iconAfter|disabled|as|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, full, icon, iconAfter, disabled, as, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|paper|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'solid' | 'paper' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:marker|tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: marker, tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|primary|muted)$/]",
        "message": "<Eyebrow> tone must be one of 'accent' | 'primary' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|icons|style|key|ref|className|style|children)$/]",
        "message": "<FeatureRow> doesn't accept that prop. Declared props: items, icons, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|radius|pad|children|style|key|ref|className|style|children)$/]",
        "message": "<FlatCard> doesn't accept that prop. Declared props: tone, radius, pad, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:card|raised|inset|paper|accent|outline)$/]",
        "message": "<FlatCard> tone must be one of 'card' | 'raised' | 'inset' | 'paper' | 'accent' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlatCard'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:lg|md|sm|top|bottom)$/]",
        "message": "<FlatCard> radius must be one of 'lg' | 'md' | 'sm' | 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|weight|fill|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, weight, fill, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|label|variant|selected|size|disabled|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: name, label, variant, selected, size, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|tonal|filled)$/]",
        "message": "<IconButton> variant must be one of 'plain' | 'tonal' | 'filled'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|withWordmark|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: size, tone, withWordmark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|primary|blue|current)$/]",
        "message": "<Logo> tone must be one of 'accent' | 'primary' | 'blue' | 'current'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadialRings'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|rings|opacity|ratio|color|style|key|ref|className|style|children)$/]",
        "message": "<RadialRings> doesn't accept that prop. Declared props: size, rings, opacity, ratio, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|label|valueLabel|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: value, min, max, label, valueLabel, disabled, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoreBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:store|variant|href|style|key|ref|className|style|children)$/]",
        "message": "<StoreBadge> doesn't accept that prop. Declared props: store, variant, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoreBadge'] > JSXAttribute[name.name='store'] > Literal[value!=/^(?:ios|android)$/]",
        "message": "<StoreBadge> store must be one of 'ios' | 'android'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoreBadge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|paper|outline)$/]",
        "message": "<StoreBadge> variant must be one of 'solid' | 'paper' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|disabled|label|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, disabled, label, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|dot|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: variant, dot, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|accent|quiet)$/]",
        "message": "<Tag> variant must be one of 'outline' | 'accent' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Waveform'] > JSXAttribute > JSXIdentifier[name!=/^(?:bars|height|seed|gap|min|playedTo|style|key|ref|className|style|children)$/]",
        "message": "<Waveform> doesn't accept that prop. Declared props: bars, height, seed, gap, min, playedTo, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
